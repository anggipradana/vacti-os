# vacti backup credentials + knobs. Copy to /etc/vacti/backup.env, fill in, then:
#   sudo install -o root -g root -m 600 backup.env.example /etc/vacti/backup.env  (then edit)
# NEVER commit the real file. It holds the ONLY key that can decrypt the offsite backup.
# The scripts source this file. Values shown are placeholders and must be replaced.

# --- restic repository -------------------------------------------------------
# Backblaze B2 (recommended, native restic backend):
export RESTIC_REPOSITORY="b2:vacti-backup-CHANGEME:vacti"
# Cloudflare R2 / any S3-compatible alternative (use a SEPARATE bucket + token, never the evidence one):
#   export RESTIC_REPOSITORY="s3:https://<accountid>.r2.cloudflarestorage.com/vacti-backup"

# Long random password that encrypts the repo client-side. LOSE THIS = LOSE THE BACKUP.
# Generate once: openssl rand -base64 48   Store a copy in the operator password manager.
export RESTIC_PASSWORD="CHANGEME-long-random-restic-repo-password"
# Alternatively point at a root-only file instead of inlining the password:
#   export RESTIC_PASSWORD_FILE="/etc/vacti/restic.pass"

# --- backend credentials -----------------------------------------------------
# For Backblaze B2 (b2: repository) - an application key SCOPED to the one backup bucket:
export B2_ACCOUNT_ID="CHANGEME-b2-keyID"
export B2_ACCOUNT_KEY="CHANGEME-b2-applicationKey"

# For S3 / R2 (s3: repository) instead of B2, set these and comment out the B2 pair above:
#   export AWS_ACCESS_KEY_ID="CHANGEME"
#   export AWS_SECRET_ACCESS_KEY="CHANGEME"
#   export AWS_DEFAULT_REGION="auto"   # R2 uses "auto"

# --- retention (restic forget --keep-*) --------------------------------------
export KEEP_DAILY="${KEEP_DAILY:-7}"
export KEEP_WEEKLY="${KEEP_WEEKLY:-4}"
export KEEP_MONTHLY="${KEEP_MONTHLY:-6}"

# --- optional failure alert --------------------------------------------------
# A webhook that accepts a `text` form field (e.g. an ops bot relay). Left empty = no alert,
# but the systemd OnFailure unit and the /var/log file still record the failure.
export ALERT_WEBHOOK=""
