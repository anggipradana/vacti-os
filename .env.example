# vacti environment - copy to `.env` and fill in real values.
# Files matching `.env*` are git-ignored EXCEPT `.env.example`. Never commit secrets.

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://vacti:vacti@localhost:5432/vacti
# Postgres password for the Docker Compose stack (set a strong value; do NOT keep the default).
POSTGRES_PASSWORD=vacti

# --- Security ---
# 32-byte base64 key for AES-256-GCM vault encryption (openssl rand -base64 32)
ENCRYPTION_KEY=

# --- First-run admin (seed) ---
ADMIN_EMAIL=admin@vacti.local
ADMIN_PASSWORD=

# --- External APIs (optional - features degrade gracefully when absent) ---
OTX_API_KEY=
# LeakCheck, the unified leak-search provider (optional)
LEAKCHECK_API_KEY=
# VirusTotal passive DNS for passive recon (Wayback Machine works without any key)
VT_API_KEY=
# URLScan.io (passive recon; works key-less but rate-limited)
URLSCAN_API_KEY=
# Optional outbound proxy for worker OSINT/deep-fetch traffic (http(s):// or socks5://)
PROXY_URL=

# --- Worker tuning (optional - sane defaults ship in code) ---
# How many scans the worker runs in parallel (default 2).
SCAN_CONCURRENCY=
# Watchdog threshold in milliseconds: a scan idle past this is reaped as stuck (default 60 min).
SCAN_MAX_RUNTIME_MS=
# Playwright's bundled-browser host-platform override (render.ts defaults this to ubuntu24.04 in
# code when unset; only override for a different unsupported host).
PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=

# --- Docs page (optional) ---
# Repo base URL for resolving relative markdown links to their file on GitHub.
DOCS_REPO_URL=

# --- E2E tests (optional - Playwright picks sane defaults; see apps/web/playwright.config.ts) ---
E2E_PORT=
# Isolated Next.js build dir so the e2e server never shares .next with a running dev/live server.
NEXT_DIST_DIR=

# --- AI enrichment providers (optional) ---
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# To point OpenAI at a compatible gateway (local proxy, LiteLLM), set the "Base URL" per project
# under Settings -> Integrations -> AI enrichment (not an env var).

# --- Scheduling (optional) ---
# Timezone for scan schedules + the daily news refresh (worker TZ; default Asia/Jakarta).
SCHEDULE_TZ=Asia/Jakarta

# --- News retention (optional) ---
# Threat/brand news older than this many days is auto-pruned on each TI refresh (default 90).
# Analyst-flagged "relevant"/"actioned" headlines are always kept.
NEWS_RETENTION_DAYS=90
